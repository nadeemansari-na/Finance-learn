{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./src",
     "lib": ["ESNext", "DOM", "WebWorker"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx"
  },
   "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}